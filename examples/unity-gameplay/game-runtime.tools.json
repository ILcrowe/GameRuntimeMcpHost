{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "serverName": "unity-gameplay-runtime",
  "serverVersion": "0.1.0",
  "tools": [
    {
      "name": "runtime_status",
      "description": "연결된 Unity 게임 런타임과 현재 프로세스·씬 상태를 확인합니다.",
      "command": "runtime.status",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_game_state",
      "description": "제어 대상의 위치, 체력, 목표, 이동 상태와 최근 행동 상태를 조회합니다.",
      "command": "game.get_state",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_surroundings",
      "description": "제어 대상 주변의 객체와 상호작용 가능 대상을 거리순으로 조회합니다.",
      "command": "game.get_surroundings",
      "inputSchema": {
        "type": "object",
        "properties": {
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 50,
            "default": 15,
            "description": "탐색 반경(미터)"
          },
          "maxResults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10,
            "description": "최대 결과 수"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "player_move_to",
      "description": "제어 대상을 현재 Y 높이를 유지한 채 지정한 월드 X/Z 좌표로 이동시킵니다.",
      "command": "player.move_to",
      "inputSchema": {
        "type": "object",
        "properties": {
          "targetX": {
            "type": "number",
            "description": "목표 월드 X 좌표"
          },
          "targetZ": {
            "type": "number",
            "description": "목표 월드 Z 좌표"
          }
        },
        "required": [
          "targetX",
          "targetZ"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "player_interact",
      "description": "주변 탐색 결과의 targetId를 우선 사용하여 가까운 상호작용 대상과 상호작용합니다.",
      "command": "player.interact",
      "inputSchema": {
        "type": "object",
        "properties": {
          "targetId": {
            "type": "string",
            "description": "get_surroundings가 반환한 런타임 대상 ID"
          },
          "targetName": {
            "type": "string",
            "description": "ID가 없을 때 사용하는 대상 표시 이름"
          }
        },
        "anyOf": [
          {
            "required": [
              "targetId"
            ]
          },
          {
            "required": [
              "targetName"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "send_in_game_chat",
      "description": "최대 500자의 메시지를 게임 소유 채팅 이벤트로 전달합니다.",
      "command": "chat.send",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "게임에 전달할 채팅 메시지"
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      }
    }
  ]
}
