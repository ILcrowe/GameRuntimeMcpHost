{
  "serverName": "story-runtime-mcp",
  "serverVersion": "0.2.0",
  "tools": [
    {
      "name": "start_roleplay_conversation",
      "description": "Start a player and two NPC scene-guided roleplay conversation.",
      "command": "roleplay.start",
      "inputSchema": {
        "type": "object",
        "properties": {
          "objective": { "type": "string" },
          "publicContext": { "type": "string" },
          "quality": {
            "type": "object",
            "description": "Optional quality rules. On quality_retry, regenerate only the structured turn using result.quality.issueList.",
            "properties": {
              "participantRuleList": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "participantId": { "type": "string" },
                    "forbiddenPhraseList": { "type": "array", "items": { "type": "string" } }
                  },
                  "required": ["participantId"],
                  "additionalProperties": false
                }
              },
              "sceneForbiddenPhraseList": { "type": "array", "items": { "type": "string" } },
              "metaLeakPhraseList": { "type": "array", "items": { "type": "string" } },
              "repetitionSimilarityThreshold": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_roleplay_turn",
      "description": "Read the next roleplay participant and its scoped scene context.",
      "command": "roleplay.get_turn",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
    },
    {
      "name": "submit_roleplay_npc_line",
      "description": "Submit the current NPC participant line.",
      "command": "roleplay.submit",
      "inputSchema": {
        "type": "object",
        "properties": {
          "participantId": { "type": "string" },
          "content": { "type": "string" }
        },
        "required": ["participantId", "content"],
        "additionalProperties": false
      }
    },
    {
      "name": "submit_roleplay_player_line",
      "description": "Submit the automated player's current roleplay line. This enables fully LLM-driven scenes without human keyboard input.",
      "command": "roleplay.submit_player",
      "inputSchema": {
        "type": "object",
        "properties": {
          "content": { "type": "string" }
        },
        "required": ["content"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_roleplay_conversation",
      "description": "Read the current roleplay conversation snapshot.",
      "command": "roleplay.get",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
    },
    {
      "name": "get_roleplay_turn_outputs",
      "description": "Read accepted structured turns at Player, MindReading, or Debug visibility. Player is the default and never returns inner monologue or debug metadata.",
      "command": "roleplay.get_outputs",
      "inputSchema": {
        "type": "object",
        "properties": {
          "visibility": { "type": "string", "enum": ["Player", "MindReading", "Debug"] }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "submit_roleplay_npc_turn",
      "description": "Submit structured NPC speech, inner monologue, action proposal, and presentation hints.",
      "command": "roleplay.submit_turn",
      "inputSchema": {
        "type": "object",
        "properties": {
          "participantId": { "type": "string" },
          "content": {
            "type": "object",
            "properties": {
              "spokenText": { "type": "string" },
              "innerMonologueText": { "type": "string" },
              "actionProposal": { "type": "string" },
              "retryCount": { "type": "integer" },
              "presentation": {
                "type": "object",
                "properties": {
                  "textStyleKey": { "type": "string" },
                  "sfxCueKey": { "type": "string" },
                  "expressionKey": { "type": "string" }
                }
              }
            },
            "required": ["spokenText"]
          }
        },
        "required": ["participantId", "content"],
        "additionalProperties": false
      }
    },
    {
      "name": "stop_roleplay_conversation",
      "description": "Stop the current roleplay conversation with a recorded reason.",
      "command": "roleplay.stop",
      "inputSchema": {
        "type": "object",
        "properties": { "reason": { "type": "string" } },
        "additionalProperties": false
      }
    },
    {
      "name": "get_runtime_status",
      "description": "Read the connected game's product, Unity version, play state, and authoritative turn.",
      "command": "runtime.status",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "list_controllable_units",
      "description": "List units whose current turn can be controlled through the runtime gateway.",
      "command": "turn.list_units",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
    },
    {
      "name": "get_pending_turn_decisions",
      "description": "List unresolved turn decisions and their legal action sets.",
      "command": "turn.get_pending",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
    },
    {
      "name": "ensure_turn_decision",
      "description": "Open or read the authoritative decision for a unit's current turn.",
      "command": "turn.ensure",
      "inputSchema": {
        "type": "object",
        "properties": {
          "unitId": { "type": "string" },
          "timeoutSeconds": { "type": "number", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_turn_context",
      "description": "Read one decision's authoritative state and legal actions before submitting.",
      "command": "turn.get_context",
      "inputSchema": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "object",
            "properties": {
              "battleId": { "type": "string" },
              "turnId": { "type": "integer" },
              "unitId": { "type": "string" },
              "decisionVersion": { "type": "integer" }
            },
            "required": ["battleId", "turnId", "unitId", "decisionVersion"],
            "additionalProperties": false
          }
        },
        "required": ["decision"],
        "additionalProperties": false
      }
    },
    {
      "name": "submit_turn_action",
      "description": "Submit one legal action with decision identity and an idempotency key.",
      "command": "turn.submit",
      "inputSchema": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "object",
            "properties": {
              "battleId": { "type": "string" },
              "turnId": { "type": "integer" },
              "unitId": { "type": "string" },
              "decisionVersion": { "type": "integer" }
            },
            "required": ["battleId", "turnId", "unitId", "decisionVersion"],
            "additionalProperties": false
          },
          "actionId": { "type": "string" },
          "idempotencyKey": { "type": "string" }
        },
        "required": ["decision", "actionId", "idempotencyKey"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_turn_result",
      "description": "Read the accepted, rejected, or fallback result for a turn decision.",
      "command": "turn.get_result",
      "inputSchema": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "object",
            "properties": {
              "battleId": { "type": "string" },
              "turnId": { "type": "integer" },
              "unitId": { "type": "string" },
              "decisionVersion": { "type": "integer" }
            },
            "required": ["battleId", "turnId", "unitId", "decisionVersion"],
            "additionalProperties": false
          }
        },
        "required": ["decision"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_pending_master_requests",
      "description": "List role-play requests awaiting an external MCP-compatible Agent.",
      "command": "master.get_pending",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_master_request",
      "description": "Read one compact provider-neutral master request.",
      "command": "master.get_request",
      "inputSchema": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string" }
        },
        "required": ["requestId"],
        "additionalProperties": false
      }
    },
    {
      "name": "submit_master_response",
      "description": "Submit narration for one master request. clientName is observational only.",
      "command": "master.submit_response",
      "inputSchema": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string" },
          "sessionId": { "type": "string" },
          "revision": { "type": "integer" },
          "idempotencyKey": { "type": "string" },
          "narration": { "type": "string" },
          "dialogue": { "type": "string" },
          "clientName": { "type": "string" }
        },
        "required": [
          "requestId",
          "sessionId",
          "revision",
          "idempotencyKey",
          "narration"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_master_result",
      "description": "Read the accepted or fallback result for a master request.",
      "command": "master.get_result",
      "inputSchema": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string" }
        },
        "required": ["requestId"],
        "additionalProperties": false
      }
    },
    {
      "name": "start_worldbuilding_experiment",
      "description": "Start a bounded multi-character worldbuilding conversation owned by the active Unity test scene.",
      "command": "experiment.start",
      "inputSchema": {
        "type": "object",
        "properties": {
          "topic": { "type": "string" },
          "source": { "type": "string" },
          "maxTurns": { "type": "integer", "minimum": 1 },
          "participants": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "participantId": { "type": "string" },
                "displayName": { "type": "string" },
                "provider": { "type": "string" },
                "role": { "type": "string" }
              },
              "required": ["participantId", "displayName", "provider", "role"],
              "additionalProperties": false
            }
          }
        },
        "required": ["topic", "source", "maxTurns", "participants"],
        "additionalProperties": false
      }
    },
    {
      "name": "submit_experiment_utterance",
      "description": "Submit the expected character's next utterance to the Unity-owned conversation.",
      "command": "experiment.submit",
      "inputSchema": {
        "type": "object",
        "properties": {
          "participantId": { "type": "string" },
          "content": { "type": "string" }
        },
        "required": ["participantId", "content"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_worldbuilding_experiment",
      "description": "Read the Unity-owned experiment state, next speaker, participants, and transcript.",
      "command": "experiment.get",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ]
}
